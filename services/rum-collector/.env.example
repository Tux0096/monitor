# Подключение к той же базе, что и остальные сервисы monitor
DATABASE_URL=postgresql://monitor:PASSWORD@monitor-postgres:5432/monitor_core

# Порт сервиса (диапазон 31xx, см. docs/ARCHITECTURE.md)
PORT=3105

# Секрет для чтения отчётов и служебных эндпоинтов.
# Тот же, что у web и push — иначе повторится история с 401 на subscribe.
PERFORMANCE_IMPORT_SECRET=

# Origin, с которых принимаем метрики. Через запятую.
# Пропущенный origin = данные с этой платформы молча теряются.
RUM_ALLOWED_ORIGINS=https://fuji.ru,https://www.fuji.ru,https://app.fuji.ru,capacitor://localhost,http://localhost,ionic://localhost

# Сколько суток хранить сырые события (свёртки живут вечно)
RUM_RAW_RETENTION_DAYS=14

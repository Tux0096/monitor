# Порт из диапазона 31xx (см. docs/ARCHITECTURE.md)
PORT=3106

# Своя база кабинета — та же monitor_core, таблицы с префиксом cab_
DATABASE_URL=postgresql://monitor:PASSWORD@monitor-postgres:5432/monitor_core

# Telegram. На этапе разработки — тестовый бот.
# Кто знает токен, тот подделает initData и войдёт под любым сотрудником,
# поэтому перед переносом на прод токен ротировать.
CABINET_BOT_TOKEN=
MINIAPP_PUBLIC_URL=https://it.franchise-fuji.ru/cabinet

# Источник данных CRM: seed | postgres
# seed  — фикстуры из репозитория, ни одного внешнего подключения
# postgres — боевая fuji_new, роль строго read-only
CRM_SOURCE=seed
CRM_DSN=
CRM_POOL_SIZE=5
CRM_STATEMENT_TIMEOUT_MS=3000

# Сессии. Секрет обязателен и в seed-режиме, минимум 32 символа.
JWT_SECRET=
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=30
INIT_DATA_MAX_AGE_SEC=60

CABINET_ALLOWED_ORIGINS=https://it.franchise-fuji.ru,https://web.telegram.org
